# 含节点凭据的完整配置（uuid / password / 服务器地址）
FlClash-移动端配置.yaml
FlClash-Gist-订阅.yaml
config.yaml
profiles/

# 兜底：所有 yaml 默认忽略。确实需要放模板时，命名为 *.yaml.example
*.yaml
*.yml
!*.yaml.example
!*.yml.example

# 订阅链接、备份、临时产物
*订阅*.yaml
*backup*/
*.bak
*.log

# 系统垃圾
.DS_Store
__pycache__/
*.pyc

# iOS 精简配置含节点凭据，永不提交
ios/*.yaml
Clash-iOS*.yaml
